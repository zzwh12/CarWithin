            "state": "translated",
            "value": "<meta charset=utf-8><h1>HTTPS Certificate Configured</h1><p>No local root certificate is needed when using a public CA certificate.</p><a href=\"https://{1}:{2}/\">Open HTTPS Receiver Page</a>"
