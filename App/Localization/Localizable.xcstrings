    "CarLife 发现包有 {1}/{2} 个发送失败（errno {3}）；广播在 iOS 上可能被限制，仍会逐个地址发送。找不到车机时请填写车机 IP": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to send {1}/{2} CarLife discovery packets (errno {3}). iOS may restrict broadcasts; packets will still be sent to individual addresses. If discovery fails, enter the head unit’s IP address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CarLife 发现包有 {1}/{2} 个发送失败（errno {3}）；广播在 iOS 上可能被限制，仍会逐个地址发送。找不到车机时请填写车机 IP"
          }
        }
      }
    },
