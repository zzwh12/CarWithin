            "value": "使用说明"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User Guide"
          }
        }
      }
    },
    "1. 先连 Wi-Fi": {
      "comment": "S518 | App/ReceiverViewController.swift:2068",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 先连 Wi-Fi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Connect to Wi-Fi"
          }
        }
      }
    },
    "让 iPhone 加入 Wi-Fi": {
      "comment": "S519 | App/ReceiverViewController.swift:2069",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 iPhone 加入 Wi-Fi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the iPhone to Wi-Fi"
          }
        }
      }
    },
    "路由器、车机 Wi-Fi 或另一台手机的热点都可以。有网、没网都能投屏。运行 CarWithin 的 iPhone 需要实际加入 Wi-Fi，自己开热点不能代替这一步。": {
      "comment": "S520 | App/ReceiverViewController.swift:2070",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路由器、车机 Wi-Fi 或另一台手机的热点都可以。有网、没网都能投屏。运行 CarWithin 的 iPhone 需要实际加入 Wi-Fi，自己开热点不能代替这一步。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a router, the head unit’s Wi-Fi, or another phone’s hotspot. Screen projection works with or without internet access. The iPhone running CarWithin must join a Wi-Fi network; turning on its own Personal Hotspot does not replace this step."
          }
        }
      }
    },
    "选择同名预设": {
      "comment": "S521 | App/ReceiverViewController.swift:2071",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择同名预设"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the Matching Preset"
          }
        }
      }
    },
    "回到 CarWithin，在「Wi-Fi 预设」选择刚连的网络。第一次用，在「Wi-Fi 与网络」添加。": {
      "comment": "S522 | App/ReceiverViewController.swift:2072",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 CarWithin，在「Wi-Fi 预设」选择刚连的网络。第一次用，在「Wi-Fi 与网络」添加。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to CarWithin and select the network you just joined under “Wi-Fi Presets”. For first-time use, add it under “Wi-Fi & Network”."
          }
        }
      }
    },
    "2. 选一种输出": {
      "comment": "S523 | App/ReceiverViewController.swift:2074",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 选一种输出"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Choose an Output"
          }
        }
      }
    },
    "车机连同一个 Wi-Fi。在「当前输出」选浏览器，启动 CarPlay，再用车机打开首页显示的 HTTP 地址。": {
      "comment": "S524 | App/ReceiverViewController.swift:2076",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车机连同一个 Wi-Fi。在「当前输出」选浏览器，启动 CarPlay，再用车机打开首页显示的 HTTP 地址。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the head unit to the same Wi-Fi network. Choose Browser under “Current Output”, start CarPlay, then open the HTTP address shown on the home screen from the head unit."
          }
        }
      }
    },
    "车机或仪表": {
      "comment": "S525 | App/ReceiverViewController.swift:2077",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车机或仪表"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head Unit or Dashboard"
          }
        }
      }
    },
    "使用仪表时先加入仪表 Wi-Fi，再按首页连接卡的顺序操作。CarLife 先打开车机上的 CarLife；AirPlay 在首页选接收设备。": {
      "comment": "S526 | App/ReceiverViewController.swift:2078",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用仪表时先加入仪表 Wi-Fi，再按首页连接卡的顺序操作。CarLife 先打开车机上的 CarLife；AirPlay 在首页选接收设备。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a dashboard, join its Wi-Fi first and follow the connection card on the home screen. For CarLife, open CarLife on the head unit first. For AirPlay, select a receiver on the home screen."
          }
        }
      }
    },
    "3. 常见问题": {
      "comment": "S527 | App/ReceiverViewController.swift:2080",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 常见问题"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Troubleshooting"
          }
        }
      }
    },
    "卡在正在连接": {
      "comment": "S528 | App/ReceiverViewController.swift:2081",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡在正在连接"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuck on Connecting"
          }
        }
      }
    },
    "核对 iPhone 连的 Wi-Fi 和预设是否同名。仍连不上，关开一次 Wi-Fi，回到 App 重新启动。": {
      "comment": "S529 | App/ReceiverViewController.swift:2082",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对 iPhone 连的 Wi-Fi 和预设是否同名。仍连不上，关开一次 Wi-Fi，回到 App 重新启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the iPhone’s Wi-Fi network name matches the selected preset. If it still will not connect, turn Wi-Fi off and on, return to the app, and restart."
          }
        }
      }
    },
    "网页打不开或没有画面": {
      "comment": "S530 | App/ReceiverViewController.swift:2083",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页打不开或没有画面"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page Will Not Open or No Video"
          }
        }
      }
    },
    "先核对两台设备的 Wi-Fi 和首页地址。能打开但没画面时，先试 HTTP，再把画面设为 H.264、720P、30 帧。": {
      "comment": "S531 | App/ReceiverViewController.swift:2084",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先核对两台设备的 Wi-Fi 和首页地址。能打开但没画面时，先试 HTTP，再把画面设为 H.264、720P、30 帧。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check both devices’ Wi-Fi connections and the address on the home screen. If the page opens without video, try HTTP first, then set video to H.264, 720P, and 30 FPS."
          }
        }
      }
    },
    "仪表没有画面": {
      "comment": "S532 | App/ReceiverViewController.swift:2085",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仪表没有画面"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Video on the Dashboard"
          }
        }
      }
    },
    "确认选对仪表型号、仪表已打开投屏，并在「输出设置」核对仪表 IP。先结束其他投屏。": {
      "comment": "S533 | App/ReceiverViewController.swift:2086",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认选对仪表型号、仪表已打开投屏，并在「输出设置」核对仪表 IP。先结束其他投屏。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the correct dashboard model is selected, screen projection is enabled on the dashboard, and the dashboard IP is correct under “Output Settings”. End any other screen projection sessions first."
          }
        }
      }
    },
    "HTTPS 低延迟": {
      "comment": "S534 | App/ReceiverViewController.swift:2093",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
