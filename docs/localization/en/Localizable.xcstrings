        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动帧率根据主网页选择 30 或 60 FPS。支持 H.265 的主网页会优先使用 H.265。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto frame rate selects 30 or 60 FPS based on the primary browser. H.265 is preferred when the primary browser supports it."
          }
        }
      }
    },
